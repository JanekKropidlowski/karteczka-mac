{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Karteczka",
  "version": "0.1.0",
  "identifier": "pl.kropidlowscy.karteczka",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Karteczka",
        "url": "https://task.kropidlowscy.pl/karteczka/",
        "width": 340,
        "height": 520,
        "minWidth": 280,
        "minHeight": 340,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
